# ══════════════════════════════════════════════════════════════
#  可选：docker compose 的环境变量覆盖（模板）
#  用法：cp .env.example .env
#  ⚠️ .env 已加入 .gitignore
#
#  ./scripts/setup.sh 会自动填入正确的 PUID/PGID
# ══════════════════════════════════════════════════════════════

# 时区
TZ=Asia/Shanghai

# 容器以哪个用户身份运行（默认 1000:1000 = 常见的第一个普通用户）
# 设对了，容器生成的文件属主就是你自己，宿主机上的备份脚本/编辑器都能直接读；
# 设错了（比如文件被写成 root 所有），改成你的 uid:gid 即可：运行 `id -u` / `id -g`
PUID=1000
PGID=1000

# 用户管理页监听
#   0.0.0.0        = 局域网可达（默认；公网到不了，因为 NAS 无公网 IP 且 Funnel 不暴露）
#   192.168.1.14   = 只绑局域网 IP（更严格）
#   127.0.0.1      = 只有 NAS 本机能访问
ADMIN_BIND=0.0.0.0
ADMIN_PORT=9092
