# ══════════════════════════════════════════════════════════════
#  Authelia 用户库（模板）
#
#  这个文件由【用户管理页】(http://<你的NAS>:9092) 自动维护，
#  一般不需要手改。
#
#  ⚠️ users_database.yml 已加入 .gitignore（含密码哈希）
#  ⛔ 不要手工填写 password —— 用管理页创建用户，它会自动算 argon2id 哈希
#
#  组约定：
#    admins  —— 只有一个账号，专门用来登录管理页创建用户
#    users   —— 其他所有人（包括你自己日常使用）
# ══════════════════════════════════════════════════════════════

users: {}
# 示例（管理页创建后会长这样）：
#
# users:
#   admin:
#     displayname: "管理员"
#     password: "$argon2id$v=19$m=65536,t=3,p=4$....$...."
#     email: ""
#     groups:
#       - admins
#   小明:
#     displayname: "小明"
#     password: "$argon2id$v=19$m=65536,t=3,p=4$....$...."
#     email: ""
#     groups:
#       - users
